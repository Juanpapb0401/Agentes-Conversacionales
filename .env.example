# Copia este archivo como .env y rellena tus valores reales.
# Nunca subas el .env al repositorio.

# Proveedor LLM: "openai" o "gemini"
LLM_PROVIDER=gemini

# Google Gemini (recomendado - gratis en aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu-gemini-api-key-aqui
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# OpenAI (alternativa)
OPENAI_API_KEY=sk-tu-openai-key-aqui
OPENAI_MODEL=gpt-4o-mini

# URL base de la API FastAPI (no cambiar si corres local)
API_BASE_URL=http://127.0.0.1:8000

# FinOps: presupuesto máximo por sesión en USD (default: $0.05)
SESSION_BUDGET=0.05

# Twitter/X Scraping (twscrape)
# Formato: usuario:contraseña:email,usuario2:contraseña2:email2
TWITTER_ACCOUNTS=usuario1:contraseña1:email1@gmail.com

# Proxy HTTP para twscrape (opcional, necesario si Cloudflare bloquea la IP)
# TWSCRAPE_PROXY=http://user:pass@host:port

# Modo demo: retorna tweets ficticios realistas cuando Twitter bloquea el scraping
# Activar con: true | Desactivar con: false (default)
SCRAPING_DEMO_MODE=false
