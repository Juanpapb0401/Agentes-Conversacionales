# ============================================================
# Dockerfile — FastAPI Backend (microservicios de análisis)
# Build: docker build -f Dockerfile.api -t agentes-api .
# ============================================================

FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema (necesario para algunas librerías)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copiar e instalar requerimientos primero (capa cacheable)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código fuente
COPY main.py schemas.py data_loader.py ./
COPY routers/ routers/
COPY services/ services/

# Directorio de datos (se monta como volumen externo)
RUN mkdir -p data

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
